### Lakebase CRUD through APIM. Open in VS Code with the "REST Client" extension (humao.rest-client)
### and click "Send Request" above each call. Before opening VS Code, export:
###   export APIM_GATEWAY=$(terraform -chdir=terraform output -raw apim_gateway_url)/lakebase
###   export APIM_KEY=$(terraform -chdir=terraform output -raw apim_subscription_key)

@gw = {{$processEnv APIM_GATEWAY}}
@key = {{$processEnv APIM_KEY}}

### READ: list products
GET {{gw}}/public/products?select=sku,name,category,price,stock&order=sku
Ocp-Apim-Subscription-Key: {{key}}

### READ: filter (snacks with stock < 20)
GET {{gw}}/public/products?select=sku,name,stock&category=eq.snacks&stock=lt.20
Ocp-Apim-Subscription-Key: {{key}}

### CREATE
POST {{gw}}/public/products
Ocp-Apim-Subscription-Key: {{key}}
Content-Type: application/json
Prefer: return=representation

{"sku": "BEV-900", "name": "Demo Kombucha", "category": "beverages", "price": 3.75, "stock": 24}

### UPDATE
PATCH {{gw}}/public/products?sku=eq.BEV-900
Ocp-Apim-Subscription-Key: {{key}}
Content-Type: application/json
Prefer: return=representation

{"price": 3.25}

### FUNCTION (write): adjust_stock
POST {{gw}}/public/rpc/adjust_stock
Ocp-Apim-Subscription-Key: {{key}}
Content-Type: application/json

{"p_sku": "SNK-002", "p_delta": 25}

### FUNCTION (read): inventory_summary
GET {{gw}}/public/rpc/inventory_summary
Ocp-Apim-Subscription-Key: {{key}}

### DELETE
DELETE {{gw}}/public/products?sku=eq.BEV-900
Ocp-Apim-Subscription-Key: {{key}}
Prefer: return=representation

### ERROR: no subscription key (APIM returns 401)
GET {{gw}}/public/products

### ERROR: no grant on table (Postgres 42501 passed through as 403)
GET {{gw}}/public/supplier_costs
Ocp-Apim-Subscription-Key: {{key}}
